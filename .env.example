# ─────────────────────────────────────────────────────────────
# NOVA — environment template (placeholders ONLY — never real values)
# Copy to .env and fill in; .env is gitignored and must never be committed.
# Roles: APP_ROLE=api → backend (default, full local dev); APP_ROLE=web → Vercel frontend.
# ─────────────────────────────────────────────────────────────

# api — deployment role (api | web)
APP_ROLE=api

# api — PostgreSQL connection string (local docker, Render Postgres or Neon)
DATABASE_URL=your-database-url-here

# api — JWT signing secret for auth tokens. Generate: openssl rand -base64 32
AUTH_JWT_SECRET=your-auth-jwt-secret-here

# api — exact web origin (CORS allow-list + Google OAuth redirect target)
FRONTEND_URL=http://localhost:3000

# api — Google OAuth (optional; sign-in button disabled when empty).
# Register redirect URI: {api-origin}/api/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# local/seed — demo account password used by prisma/seed.ts
SEED_DEMO_PASSWORD=your-demo-password-here

# web — browser-facing base URL of the API (e.g. https://nova-api.onrender.com)
NEXT_PUBLIC_API_URL=
