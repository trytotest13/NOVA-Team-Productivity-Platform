# ─────────────────────────────────────────────────────────────
# NOVA — environment template (placeholders ONLY — never real values)
# Copy to .env and fill in; .env is gitignored and must never be committed.
# ─────────────────────────────────────────────────────────────

# PostgreSQL connection string (local docker or Neon)
DATABASE_URL=your-database-url-here

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-here   # generate: openssl rand -base64 32

# Google OAuth (console.cloud.google.com → Credentials)
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# Seed demo account password (local/dev only)
SEED_DEMO_PASSWORD=your-demo-password-here
